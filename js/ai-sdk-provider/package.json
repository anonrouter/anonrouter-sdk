{
  "name": "@anonrouter/ai-sdk-provider",
  "version": "0.1.0",
  "description": "AnonRouter provider for the Vercel AI SDK with private inference tickets, streaming, and provider routing.",
  "license": "Apache-2.0",
  "author": "AnonRouter",
  "homepage": "https://github.com/anonrouter/anonrouter-sdk/tree/main/js/ai-sdk-provider#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/anonrouter/anonrouter-sdk.git",
    "directory": "js/ai-sdk-provider"
  },
  "bugs": {
    "url": "https://github.com/anonrouter/anonrouter-sdk/issues"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.test.json",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "anonrouter",
    "ai-sdk",
    "vercel",
    "llm",
    "private-inference"
  ],
  "dependencies": {
    "@ai-sdk/openai-compatible": "^3.0.87",
    "@ai-sdk/provider": "^4.0.37",
    "eventsource-parser": "^3.1.1"
  },
  "peerDependencies": {
    "ai": "^7.0.0",
    "zod": "^3.25.76 || ^4.1.8"
  },
  "devDependencies": {
    "@types/node": "^22",
    "ai": "^7.0.0",
    "typescript": "^5.7.2",
    "vitest": "^4.1.10",
    "zod": "^4.1.8"
  }
}
